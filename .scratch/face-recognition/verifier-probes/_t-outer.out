<!DOCTYPE html>
<html><head><style>html,body{margin:0}</style></head><body><iframe id="page" src="_t-inner.html" style="width:390px;height:844px;border:0"></iframe><pre id="r">W=390 H=844</pre><script>var f=document.getElementById("page");function go(){var w=f.contentWindow,d=f.contentDocument;if(!d||!d.body){return;}document.getElementById("r").textContent="W="+w.innerWidth+" H="+w.innerHeight;};f.addEventListener("load",go);go();</script></body></html>
